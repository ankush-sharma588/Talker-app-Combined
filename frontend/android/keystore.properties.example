# Copy this file to android/keystore.properties (NOT android/keystore.properties.example)
# and fill in your real values. NEVER commit the real file or your .jks keystore
# to git — losing this keystore means you can never update your app on the
# Play Store again under the same listing, so back it up somewhere safe
# (password manager, encrypted drive) in addition to keeping it out of git.

storeFile=../talker-release.jks
storePassword=REPLACE_ME
keyAlias=talker-key
keyPassword=REPLACE_ME
