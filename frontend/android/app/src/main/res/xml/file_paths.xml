<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capacitor's Filesystem/Camera plugins write here; FileProvider exposes
         these paths to other apps (gallery, file managers, share sheet)
         without granting broad storage access. -->
    <external-files-path name="my_images" path="Pictures" />
    <external-files-path name="my_movies" path="Movies" />
    <external-files-path name="my_downloads" path="Download" />
    <cache-path name="my_cache" path="." />
    <files-path name="my_files" path="." />
</paths>
